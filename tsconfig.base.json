{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@marketing-agent/shared": ["packages/shared/src/index.ts"],
      "@marketing-agent/db": ["packages/db/src/index.ts"],
      "@marketing-agent/llm": ["packages/llm/src/index.ts"],
      "@marketing-agent/agent-runtime": ["packages/agent-runtime/src/index.ts"],
      "@marketing-agent/kb": ["packages/kb/src/index.ts"],
      "@marketing-agent/tools": ["packages/tools/src/index.ts"],
      "@marketing-agent/orchestrator": ["packages/orchestrator/src/index.ts"],
      "@marketing-agent/seed": ["seed/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts",
    "apps/server/src/**/*.ts",
    "seed/**/*.ts",
    "*.ts"
  ],
  "exclude": ["node_modules", "apps/web", "data"]
}
