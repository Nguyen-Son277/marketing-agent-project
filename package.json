{
  "name": "marketing-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx seed/cli/seed.ts",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "kb:index": "tsx packages/kb/src/cli/index-company.ts",
    "dev:server": "tsx watch apps/server/src/main.ts",
    "dev:web": "pnpm --filter @marketing-agent/web dev",
    "build:web": "pnpm --filter @marketing-agent/web build",
    "build": "pnpm run build:web",
    "start": "tsx apps/server/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "zod": "^3.24.2",
    "tsx": "^4.20.3"
  }
}
