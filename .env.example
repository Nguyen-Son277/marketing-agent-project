# Sao chép file này thành .env rồi điền giá trị thật.
# .env đã nằm trong .gitignore — không commit bí mật.

# Bắt buộc. Khoá mã hoá API key và credential của tích hợp (AES-256-GCM).
# Tối thiểu 16 ký tự. Đổi khoá này sẽ khiến các bí mật đã lưu không giải mã được,
# nên hãy sao lưu nó cùng lúc với cơ sở dữ liệu.
APP_SECRET=doi-thanh-mot-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# Cổng máy chủ web (mặc định 3000 khi chạy local).
PORT=3000
HOST=127.0.0.1

# Đường dẫn file SQLite. Trên production hãy trỏ vào volume bền vững.
DATABASE_PATH=data/marketing.db

# Gốc vùng FILE do agent tạo ra, mỗi công ty một thư mục theo company id.
# Cố ý KHÁC gốc kho kiến thức: kho kiến thức là Markdown do người quản lý ở
# `data/companies/<slug>/kb` (do `pnpm kb:index` đọc), còn đây là nơi agent ghi
# kết quả và đọc lại. Xem docs/van-hanh.md §2.1.
COMPANIES_ROOT=data/company-files

# Gốc kho kiến thức, mỗi công ty một thư mục theo slug: `<KB_ROOT>/<slug>/kb`.
KB_ROOT=data/companies

# Số ngày một phiên đăng nhập còn hiệu lực (mặc định 30).
SESSION_TTL_DAYS=30

# Giới hạn kích thước body JSON của API, tính bằng byte (mặc định 2000000).
MAX_BODY_BYTES=2000000

# Thư mục bản dựng giao diện để phục vụ tĩnh. Bỏ trống thì tự dò `apps/web/dist`.
# WEB_DIST=

# Bỏ trống = tắt. Khi đặt, hệ thống ghi lại nguyên văn bảng kế hoạch mà parser không
# đọc được (ví dụ sau khi đổi model). Hữu ích để gỡ lỗi nhưng chứa nội dung do model
# sinh, nên chỉ bật khi cần và nhớ xoá định kỳ.
# DIAGNOSTICS_DIR=data/diagnostics

# development hoặc production. production bật cookie Secure, nên chỉ dùng khi
# thật sự phục vụ qua HTTPS.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Gateway LLM mặc định (OpenAI-compatible).
# Lệnh `pnpm db:seed` tạo sẵn một provider trỏ tới URL này và tham chiếu
# biến môi trường bên dưới để lấy khoá — khoá không được ghi vào cơ sở dữ liệu.
# ---------------------------------------------------------------------------
DEFAULT_LLM_BASE_URL=http://localhost:20128/v1
DEFAULT_LLM_API_KEY_REF=DEEPSEEK_API_KEY

# Giá trị thật cho tham chiếu trên. Bạn cũng có thể thêm provider khác
# trực tiếp trong giao diện (Cài đặt → Nhà cung cấp).
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# Embedding cho tìm kiếm ngữ nghĩa trong kho kiến thức.
# local  = chạy model ONNX trong tiến trình (mặc định, không cần mạng)
# remote = gọi API /v1/embeddings của một provider OpenAI-compatible
# hash   = giả lập tất định, chỉ dùng cho test/offline
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/multilingual-e5-small
# Số chiều vector khi buộc dùng provider hash (mặc định 256).
# EMBEDDING_DIM=256
# Chỉ dùng khi EMBEDDING_PROVIDER=remote:
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
